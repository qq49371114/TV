<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="接下来，看点什么？"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- ✨ 1. “为你推荐”的标题，我们给它一个ID，让它能接收焦点！✨ -->
    <TextView
        android:id="@+id/relatedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="为你推荐"
        android:textColor="@color/selector_title" 
        android:textSize="16sp"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/relatedRecycler"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="8dp" />

    <!-- ✨ 2. “大家都在看”的标题，也一样！✨ -->
    <TextView
        android:id="@+id/hotTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="大家都在看"
        android:textColor="@color/selector_title"
        android:textSize="16sp"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/hotRecycler"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/signature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="20dp"
        android:text="婉儿 为你推荐 💕"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />

</LinearLayout>
